# ============================================================
# fuadFolio — environment variables example
# ------------------------------------------------------------
# Copy this file to ".env" and fill in the values you need.
# On Render / Railway / Koyeb, set the same keys in the
# service's Environment tab instead.
#
# python-dotenv is already in requirements.txt, so a ".env"
# file in the project root is auto-loaded in development.
# ============================================================


# ---- Django core ----

# Django secret key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-development-only-change-in-production

# Set to True while developing, False in production.
DEBUG=True

# Comma-separated list of additional CSRF-trusted origins if you
# attach a custom domain, e.g. "https://yourdomain.com".
CSRF_EXTRA_ORIGINS=

# Neon Postgres connection string. Create one at https://neon.tech.
# When unset, the app falls back to a local SQLite file (db.sqlite3).
# Example:
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=


# ---- Site identity ----

SITE_GITHUB_USERNAME=alfahim-fuyad
SITE_EMAIL=md.alfahim.fuyad@gmail.com
SITE_LINKEDIN_URL=https://www.linkedin.com/in/al-fahim-36126636b
SITE_FACEBOOK_URL=https://www.facebook.com/alfahim07

# Used by the chatbot's system prompt. Defaults are shown.
SITE_FULL_NAME=Md. Al Fahim Fuyad
SITE_TITLE=Data Scientist | ML Engineer | AI Builder


# ---- GitHub API (optional but recommended) ----

# A personal access token lifts the unauthenticated rate limit
# (60 req/hour → 5000 req/hour). Leave blank to use unauthenticated.
GITHUB_TOKEN=


# ---- Cloudinary image storage ----

# Preferred: paste your Cloudinary URL ("cloudinary://api_key:api_secret@cloud_name").
CLOUDINARY_URL=

# Alternative: set all three individually (only used when CLOUDINARY_URL is empty).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# When neither is set, image uploads fall back to local media/ storage.
# Nothing breaks in development.


# ---- Floating chatbot (LLM providers) ----

# Primary provider. Get a free key at https://console.groq.com.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback provider — used automatically when Groq hits its rate
# limit (429) or returns a server error. Get a key at
# https://openrouter.ai.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional referer header OpenRouter uses for attribution.
OPENROUTER_HTTP_REFERER=https://fuadfolio.example


# ---- Auto-create a superuser on first deploy (optional) ----
# Used by the render.yaml blueprint. Leave blank to skip.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
